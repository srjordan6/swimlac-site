{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swimlac-site",
  "compatibility_date": "2026-08-27",

  // The Worker only handles /api/*. Everything else is served straight from
  // ./dist as a static asset, so the site stays as fast as it was.
  "main": "./worker/index.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],

    // The old GoMotion URLs have NO trailing slash (/page/about/about-lac).
    // "drop-trailing-slash" serves them at exactly that path and redirects any
    // trailing-slash variant onto it. Do not change this without re-running
    // `npm run verify` — it is what keeps the 38 legacy slugs intact.
    "html_handling": "drop-trailing-slash",

    // Serve dist/404.html on a miss instead of a bare Cloudflare error.
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true }
}
