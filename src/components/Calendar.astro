---
/**
 * Live practice calendar. Reads /api/calendar, which the Cloudflare Worker
 * serves from the club's Google Calendars. Coaches add events in Google
 * Calendar; this page picks them up within ten minutes with no deploy.
 *
 * If the calendars are not set up yet the block explains that quietly and the
 * printed schedule tables below it remain the source of truth, so the page is
 * never broken while the club is still creating the calendars.
 */
import cals from '../calendars.json';
const { site = 'all' } = Astro.props as { site?: string };
const list = site === 'all' ? cals : cals.filter((c) => c.key === site);
const heading = site === 'all' ? 'What is coming up' : 'Upcoming at this site';
---
<section class="cal" data-site={site} aria-labelledby="cal-h">
  <div class="cal-head">
    <h2 id="cal-h">{heading}</h2>
    <div class="cal-subs">
      {list.map((c) => (
        <a class="sub" href={`#subscribe-${c.key}`} data-sub={c.key} data-label={c.label}>
          Add {c.label} to your calendar
        </a>
      ))}
    </div>
  </div>

  <div class="cal-body" id="cal-body">
    <p class="cal-msg" id="cal-msg">Loading the schedule&hellip;</p>
    <ol class="cal-list" id="cal-list" hidden></ol>
  </div>
</section>

<script>
  (async function () {
    const root = document.querySelector('.cal');
    if (!root) return;
    const site = (root as HTMLElement).dataset.site || 'all';
    const msg = document.getElementById('cal-msg')!;
    const list = document.getElementById('cal-list')!;
    const subs = root.querySelectorAll<HTMLAnchorElement>('[data-sub]');

    const fmtDay = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
    const fmtTime = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' });

    let data: any;
    try {
      const r = await fetch('/api/calendar?site=' + encodeURIComponent(site), { headers: { accept: 'application/json' } });
      data = await r.json();
    } catch {
      msg.textContent = 'The schedule could not be loaded just now. The practice times below are current as printed.';
      return;
    }

    if (!data || data.configured === false) {
      msg.innerHTML = 'The live calendar is not switched on yet. <strong>The practice times printed below are the ones to follow.</strong>';
      subs.forEach((a) => a.remove());
      return;
    }
    if (!data.events || data.events.length === 0) {
      msg.textContent = 'Nothing scheduled in the next few months. The practice times below still apply.';
      return;
    }

    /* group by day so a week of practices reads as a week, not a list of rows */
    const byDay = new Map<string, any[]>();
    for (const ev of data.events) {
      const key = String(ev.start).slice(0, 10);
      if (!byDay.has(key)) byDay.set(key, []);
      byDay.get(key)!.push(ev);
    }

    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    let html = '';
    for (const [day, evs] of byDay) {
      const d = new Date(day + 'T12:00:00');
      html += '<li class="day"><div class="daylabel"><span class="dow">' + fmtDay.format(d) + '</span></div><div class="evs">';
      for (const ev of evs) {
        const when = ev.allDay ? 'All day' : fmtTime.format(new Date(ev.start)) +
          (ev.end ? ' to ' + fmtTime.format(new Date(ev.end)) : '');
        html += '<div class="ev">'
          + '<span class="when">' + esc(when) + '</span>'
          + '<span class="what">' + esc(ev.title) + '</span>'
          + (site === 'all' ? '<span class="where">' + esc(ev.siteLabel) + '</span>' : '')
          + (ev.location ? '<span class="loc">' + esc(ev.location) + '</span>' : '')
          + '</div>';
      }
      html += '</div></li>';
    }
    list.innerHTML = html;
    list.hidden = false;
    msg.hidden = true;

    /* subscribe links only make sense once ids exist, and the Worker only
       returns sites it could actually read */
    const ok = new Set((data.sites || []).map((s: any) => s.key));
    subs.forEach((a) => {
      const k = a.dataset.sub!;
      if (!ok.has(k)) { a.remove(); return; }
      a.href = '/api/calendar?site=' + encodeURIComponent(k);
      a.removeAttribute('data-sub');
    });
  })();
</script>

<style>
.cal{border:1px solid var(--line);background:rgba(13,1,4,.55);backdrop-filter:blur(8px);
  padding:clamp(20px,3vw,32px);margin-block:clamp(28px,4vw,44px)}
.cal-head{display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:baseline;
  padding-bottom:14px;margin-bottom:16px;border-bottom:1px solid var(--line)}
.cal-head h2{font-size:clamp(19px,2.2vw,26px);margin:0}
.cal-subs{display:flex;flex-wrap:wrap;gap:8px}
.sub{font-family:var(--f-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--flare);border:1px solid var(--line);padding:6px 10px;
  transition:border-color .25s ease,background .25s ease}
.sub:hover{border-color:var(--flare);background:rgba(187,0,0,.16)}
.cal-msg{color:var(--ash);font-size:14.5px}
.cal-msg strong{color:var(--white)}
.cal-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1px;
  background:var(--line)}
.day{display:grid;grid-template-columns:118px 1fr;gap:0;background:rgba(6,0,1,.72)}
.daylabel{padding:13px 14px;border-right:1px solid var(--line)}
.dow{font-family:var(--f-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--flare);font-variant-numeric:tabular-nums}
.evs{display:flex;flex-direction:column}
.ev{display:flex;flex-wrap:wrap;align-items:baseline;gap:5px 14px;padding:13px 16px}
.ev + .ev{border-top:1px solid rgba(255,120,120,.09)}
.when{font-family:var(--f-mono);font-size:12px;color:#e6dcdd;font-variant-numeric:tabular-nums;
  min-width:11ch}
.what{font-weight:600;font-size:15px}
.where,.loc{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;
  color:var(--ash)}
.where{color:var(--flare)}
@media (max-width:640px){
  .day{grid-template-columns:1fr}
  .daylabel{border-right:0;border-bottom:1px solid var(--line);padding-bottom:8px}
  .when{min-width:0}
}
</style>
