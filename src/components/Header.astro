---
import { NAV, SOCIAL, BADGES, GOMOTION, SITE } from '../consts';
const { path = '' } = Astro.props as { path?: string };
const isActive = (href: string) => path === href || (href !== '/page/home' && path.startsWith(href + '/'));
const sectionActive = (item: (typeof NAV)[number]) =>
  isActive(item.href) || !!item.children?.some((c) => isActive(c.href));

const icons: Record<string, string> = {
  facebook: 'M14 8.5h2.2V5.6c-.4-.05-1.7-.17-3.2-.17-3.2 0-5.3 1.9-5.3 5.3V13H5.2v3.3H7.7V24h3.4v-7.7h2.6l.4-3.3h-3V11c0-1 .3-2.5 2.9-2.5Z',
  x: 'M17.3 4h2.9l-6.4 7.3 7.5 9.9h-5.9l-4.6-6-5.3 6H2.6l6.8-7.8L2.2 4h6l4.2 5.5L17.3 4Zm-1 15.4h1.6L7.8 5.7H6.1l10.2 13.7Z',
  instagram: 'M12 2.2c3.2 0 3.6 0 4.9.07 3.3.15 4.8 1.7 5 5 .06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.15 3.3-1.7 4.8-5 5-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-3.3-.15-4.8-1.7-5-5C2.06 15.6 2 15.2 2 12s0-3.6.07-4.9c.15-3.3 1.7-4.8 5-5C8.4 2.2 8.8 2.2 12 2.2Zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8Zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.1-8.3a1.15 1.15 0 1 0 0-2.3 1.15 1.15 0 0 0 0 2.3Z',
  youtube: 'M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3-5.2 3Z',
};
---
<header class="hdr" id="hdr">
  <!-- utility bar: identity, socials, accreditation, member sign in -->
  <div class="util">
    <div class="util-in">
      <a class="brand" href="/page/home" aria-label={SITE.name + ' home'}>
        <img src="/logo/lac-swimming.png" alt={SITE.name} width="150" height="86" onerror="this.classList.add('gone')" />
        <span class="brandfall" aria-hidden="true"><i class="bead"></i><b>LAC</b><em>SWIMMING</em></span>
      </a>

      <ul class="socials">
        {SOCIAL.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[s.icon]} /></svg>
            </a>
          </li>
        ))}
      </ul>

      <ul class="badges">
        {BADGES.map((b) => (
          <li>
            <a href={b.href} target="_blank" rel="noopener noreferrer" title={b.label}>
              {b.img
                ? <img src={b.img} alt={b.label} height="52" loading="lazy" onerror="this.closest('a').classList.add('txt')" />
                : <span class="btxt">{b.text}</span>}
              <span class="bfall">{(b as any).short ?? b.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <a class="signin" href={GOMOTION.signIn}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17v-2H5V9h5V7l4 5-4 5Zm2-15a10 10 0 1 1-7.5 16.6l1.5-1.3A8 8 0 1 0 12 4a8 8 0 0 0-6 2.7L4.5 5.4A10 10 0 0 1 12 2Z"/></svg>
        <span>Sign In</span>
      </a>

      <button class="burger" id="burger" aria-expanded="false" aria-controls="drawer" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- primary nav: 34 links, every slug preserved from the old site -->
  <nav class="mainnav" aria-label="Primary">
    <ul class="nav-in">
      {NAV.map((item) => (
        <li class:list={['navitem', { kids: !!item.children, on: sectionActive(item) }]}>
          <a
            class="toplink"
            href={item.href}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >{item.label}</a>
          {item.children && (
            <>
              <button class="caret" aria-expanded="false" aria-label={`Open ${item.label} menu`}>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4" /></svg>
              </button>
              <ul class="drop">
                {item.children.map((c) => (
                  <li>
                    <a
                      href={c.href}
                      {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      aria-current={isActive(c.href) ? 'page' : undefined}
                    >
                      {c.label}
                      {c.external && <svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2h6v6M10 2 3 9"/></svg>}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<!-- mobile drawer: same 34 links, accordion sections -->
<div class="drawer" id="drawer" hidden>
  <ul>
    {NAV.map((item) => (
      <li>
        <div class="drow">
          <a href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}</a>
          {item.children && (
            <button class="dcaret" aria-expanded="false" aria-label={`Open ${item.label} menu`}>
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4"/></svg>
            </button>
          )}
        </div>
        {item.children && (
          <ul class="dsub">
            {item.children.map((c) => (
              <li><a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{c.label}</a></li>
            ))}
          </ul>
        )}
      </li>
    ))}
    <li class="dsign"><a class="btn btn-hot" href={GOMOTION.signIn}><span class="lbl">Sign In</span></a></li>
  </ul>
</div>
