---
import { SITE, NAV, SOCIAL, GOMOTION, LOCATIONS } from '../consts';
const cols = [
  { h: 'Swim Team', items: NAV.find((n) => n.label === 'Swim Team')?.children ?? [] },
  { h: 'Lessons', items: NAV.find((n) => n.label === 'Lessons')?.children ?? [] },
  { h: 'About', items: NAV.find((n) => n.label === 'About')?.children ?? [] },
  {
    h: 'Compete',
    items: [
      { label: 'Schedules', href: '/page/program-info' },
      { label: 'Team Records', href: '/page/events/team-records1' },
      { label: 'Time Standards', href: '/page/events/time-standards' },
      { label: 'Calendar', href: GOMOTION.calendar, external: true },
      { label: 'Alumni', href: '/page/alumni' },
      { label: 'TU Money', href: '/page/tu-money' },
    ],
  },
];
const year = 2026;
---
<footer class="ftr">
  <div class="wrap">
    <div class="fgrid">
      <div class="fbrand">
        <a class="fmark" href="/page/home">
          <span class="bead" aria-hidden="true"></span>
          <span><b>LAKESIDE AQUATIC CLUB</b><em>501(c)(3) nonprofit · Est. {SITE.founded}</em></span>
        </a>
        <p class="ftag">ONE TEAM · ONE VISION · ONE GOAL</p>
        <p class="fmission">{SITE.mission}</p>
        <ul class="fsocial">
          {SOCIAL.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
          ))}
        </ul>
      </div>

      {cols.map((c) => (
        <nav class="fcol" aria-label={c.h}>
          <h4>{c.h}</h4>
          <ul>
            {c.items.map((i: any) => (
              <li>
                <a href={i.href} {...(i.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{i.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="fpools">
      {LOCATIONS.map((l) => (
        <a class="fpool" href={l.schedule}>
          <span class="city">{l.city}</span>
          <span class="fac">{l.facility}</span>
        </a>
      ))}
    </div>

    <div class="fbot">
      <span>© {year} {SITE.name}. All rights reserved.</span>
      <span><a href={GOMOTION.signIn}>Member sign in</a> · Registration and billing are handled in GoMotion.</span>
    </div>
  </div>
</footer>

<style>
.ftr{position:relative;z-index:3;border-top:1px solid var(--line);
  background:linear-gradient(180deg,rgba(3,0,1,.90),rgba(3,0,1,.98));backdrop-filter:blur(14px);
  padding:clamp(48px,7vw,88px) 0 28px}
.fgrid{display:grid;grid-template-columns:1.6fr repeat(4,1fr);gap:clamp(22px,3vw,40px)}
.fmark{display:flex;align-items:center;gap:11px}
.fmark .bead{width:28px;height:28px;flex:none;border-radius:50%;
  background:radial-gradient(circle at 34% 30%,var(--swoosh),var(--brand) 58%,#2a0002);
  box-shadow:0 0 0 1px rgba(240,60,60,.5),0 0 20px rgba(212,0,0,.4)}
.fmark b{font-family:var(--f-display);font-weight:900;font-size:14px;letter-spacing:-.01em;display:block}
.fmark em{font-family:var(--f-mono);font-style:normal;font-size:9.5px;letter-spacing:.14em;color:var(--ash);display:block;margin-top:3px}
.ftag{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.3em;color:var(--flare);margin-top:16px}
.fmission{color:var(--ash);font-size:13.5px;margin-top:12px;max-width:38ch}
.fsocial{display:flex;flex-wrap:wrap;gap:14px;list-style:none;margin:18px 0 0;padding:0}
.fsocial a{font-family:var(--f-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ash);transition:color .25s ease}
.fsocial a:hover{color:var(--flare)}
.fcol h4{font-family:var(--f-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash);margin:0 0 14px;font-weight:400}
.fcol ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.fcol a{font-size:13.5px;color:#e6dcdd;opacity:.78;transition:opacity .22s ease,color .22s ease;line-height:1.35;display:block}
.fcol a:hover{opacity:1;color:var(--flare)}
.fpools{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:clamp(36px,5vw,56px)}
.fpool{border:1px solid var(--line);padding:16px 18px;transition:border-color .3s ease,background .3s ease,transform .4s var(--ease)}
.fpool:hover{border-color:var(--line-strong);background:rgba(187,0,0,.10);transform:translateY(-3px)}
.fpool .city{display:block;font-family:var(--f-display);font-weight:900;font-size:17px;letter-spacing:-.02em}
.fpool .fac{display:block;color:var(--ash);font-size:12px;margin-top:5px}
.fbot{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;border-top:1px solid var(--line);
  margin-top:clamp(32px,4vw,48px);padding-top:22px;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.06em;color:var(--ash)}
.fbot a{color:var(--flare)}
@media (max-width:1080px){
  .fgrid{grid-template-columns:1fr 1fr 1fr}
  .fbrand{grid-column:1 / -1}
  .fpools{grid-template-columns:1fr 1fr}
}
@media (max-width:640px){
  .fgrid{grid-template-columns:1fr 1fr}
  .fpools{grid-template-columns:1fr}
}
</style>
