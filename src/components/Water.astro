---
// Live water background. One fullscreen fragment shader, no 3D library.
// mode="hero"    full scroll-driven descent, used on the home page
// mode="ambient" fixed shallow camera, dimmer, used on interior pages
const { mode = 'ambient' } = Astro.props as { mode?: 'hero' | 'ambient' };
---
<canvas id="gl" aria-hidden="true" data-mode={mode}></canvas>
<div id="veil"></div>
<canvas id="bubbles" aria-hidden="true"></canvas>

<script>
(function () {
  'use strict';
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cv = document.getElementById('gl') as HTMLCanvasElement | null;
  const veil = document.getElementById('veil') as HTMLElement | null;
  const bc = document.getElementById('bubbles') as HTMLCanvasElement | null;
  if (!cv || !veil) return;
  const HERO = cv.dataset.mode === 'hero';
  const gl = cv.getContext('webgl2', { antialias: false, alpha: false, powerPreference: 'high-performance' });

  const VS = '#version 300 es\nin vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FS = [
    '#version 300 es',
    'precision highp float;',
    'out vec4 O;',
    'uniform vec2 R;uniform float T;uniform float S;uniform vec2 M;uniform float LF;uniform float LI;uniform float HERO;',
    'const float FL=-6.5;',
    'float h21(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}',
    'float vn(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);',
    ' return mix(mix(h21(i),h21(i+vec2(1,0)),f.x),mix(h21(i+vec2(0,1)),h21(i+vec2(1,1)),f.x),f.y);}',
    'float caus(vec2 uv,float t){',
    ' vec2 p=uv*6.2831-250.0;vec2 i=p;float c=1.0;float inten=.0055;',
    ' for(int n=0;n<3;n++){float tt=t*(1.0-(3.5/float(n+1)));',
    '  i=p+vec2(cos(tt-i.x)+sin(tt+i.y),sin(tt-i.y)+cos(tt+i.x));',
    '  c+=1.0/length(vec2(p.x/(sin(i.x+tt)/inten),p.y/(cos(i.y+tt)/inten)));}',
    ' c/=3.0;c=1.17-pow(c,1.4);return clamp(pow(abs(c),7.0),0.0,1.0);}',
    'float shaft(vec2 p,float t){',
    ' float a=sin(p.x*1.7+t*.6)*sin(p.y*1.3-t*.45);',
    ' float b=sin(p.x*3.1-t*.35+1.7)*sin(p.y*2.6+t*.5);',
    ' return pow(clamp(a*.5+b*.5+.5,0.,1.),3.5);}',
    'vec2 wav(vec2 p,float t){',
    ' float a=vn(p*0.9+vec2(t*.13,t*.09));float b=vn(p*2.1-vec2(t*.21,t*.17));',
    ' return vec2(a-.5,b-.5);}',
    'vec3 tiles(vec3 p){',
    ' vec2 q=p.xz/0.55;vec2 g=abs(fract(q)-0.5);',
    ' float grout=smoothstep(0.45,0.5,max(g.x,g.y));',
    ' vec3 c=mix(vec3(.27,.250,.256),vec3(.128,.116,.120),grout);',
    ' float lx=abs(mod(p.x+1.2,2.4)-1.2);',
    ' c=mix(c,vec3(.58,.020,.028),smoothstep(0.155,0.115,lx));return c;}',
    'vec3 flo(vec3 p,float t){',
    ' vec2 q=p.xz/0.55;vec2 g=abs(fract(q)-0.5);',
    ' float grout=smoothstep(0.45,0.5,max(g.x,g.y));',
    ' vec3 c=mix(vec3(.27,.250,.256),vec3(.128,.116,.120),grout);',
    ' float lx=abs(mod(p.x+1.2,2.4)-1.2);',
    ' float lane=smoothstep(0.155,0.115,lx);',
    ' float tz=abs(mod(p.z+12.5,25.0)-12.5);',
    ' float crs=smoothstep(0.17,0.12,tz)*smoothstep(0.78,0.72,lx);',
    ' c=mix(c,vec3(.58,.020,.028),max(lane,crs));',
    ' float fl=abs(p.x-LF*2.4);',
    ' c+=vec3(1.0,.20,.16)*LI*smoothstep(1.45,0.10,fl)*1.15;',
    ' float k=caus(p.xz*0.11+wav(p.xz*0.25,t)*0.05,t*0.32);',
    ' c+=vec3(1.0,.68,.60)*k*1.05;',
    ' return c;}',
    'void main(){',
    ' vec2 uv=(gl_FragCoord.xy*2.-R)/R.y;',
    ' float s=smoothstep(0.,1.,S)*HERO;',
    ' float cy=mix(-1.55,-4.9,s);',
    ' float cz=S*46.0*HERO+T*0.55;',
    ' float pit=mix(0.235,-0.16,s);',
    ' vec3 ro=vec3(M.x*0.7,cy,cz);',
    ' vec3 rd=normalize(vec3(uv.x,uv.y*0.92+pit+M.y*0.10,1.35));',
    ' vec2 md=uv-vec2(M.x*(R.x/R.y)*0.9,M.y*0.9);',
    ' float dl=length(md);',
    ' float rip=sin(dl*13.0-T*2.3)*exp(-dl*3.0)*0.030;',
    ' rd=normalize(rd+vec3(md*rip,0.0));',
    ' vec3 col;float fog;',
    ' if(rd.y<-0.0015){',
    '  float t=(FL-ro.y)/rd.y;vec3 p=ro+rd*t;',
    '  col=flo(p,T);fog=1.0-exp(-t*0.058);',
    ' }else{',
    '  float t=(0.0-ro.y)/max(rd.y,1e-4);vec3 p=ro+rd*t;',
    '  vec2 w=wav(p.xz*0.6,T);',
    '  vec3 n=normalize(vec3(-w.x*0.19,1.0,-w.y*0.19));',
    '  float ct=dot(rd,n);',
    '  float CR=0.6614;',
    '  if(ct>CR){',
    '   float k=smoothstep(CR,CR+0.085,ct);',
    '   vec3 sky=mix(vec3(.38,.038,.034),vec3(.88,.80,.78),k);',
    '   sky+=vec3(1.0,.90,.84)*pow(clamp(ct,0.,1.),30.0)*1.05;',
    '   sky+=vec3(1.0,.60,.52)*caus(p.xz*0.09,T*0.30)*0.26;',
    '   col=sky;fog=1.0-exp(-t*0.026);',
    '  }else{',
    '   vec3 r=reflect(rd,n);',
    '   float t2=(FL-p.y)/min(r.y,-1e-4);',
    '   col=tiles(p+r*t2)*0.62;',
    '   fog=1.0-exp(-(t+t2)*0.050);',
    '   col+=vec3(1.0,.40,.32)*smoothstep(CR-0.045,CR,ct)*1.05;',
    '  }',
    ' }',
    ' vec3 water=mix(vec3(.046,.0105,.0125),vec3(.003,.0005,.0008),s);',
    ' col=mix(col,water,clamp(fog,0.,1.));',
    ' float ray=0.0;',
    ' for(int i=0;i<8;i++){',
    '  float fi=(float(i)+.5)/8.0;float d=fi*26.0;',
    '  vec3 sp=ro+rd*d;',
    '  ray+=shaft(sp.xz*0.55,T*0.9)*exp(min(sp.y,0.0)*0.30)*(1.0-fi)*step(sp.y,0.0);',
    ' }',
    ' ray/=8.0;',
    ' col+=vec3(1.0,.47,.39)*ray*1.85*(1.0-s*0.40);',
    ' col*=1.0-0.70*pow(length(uv*vec2(0.50,0.58)),2.0);',
    ' col=pow(max(col,0.0),vec3(0.90));',
    ' O=vec4(col,1.0);}',
  ].join('\n');

  let quality = 1.0, glOK = false;
  const uni: Record<string, WebGLUniformLocation | null> = {};

  function sh(type: number, src: string) {
    const s = gl!.createShader(type)!;
    gl!.shaderSource(s, src); gl!.compileShader(s);
    if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) { console.error(gl!.getShaderInfoLog(s)); return null; }
    return s;
  }

  if (gl) {
    const vs = sh(gl.VERTEX_SHADER, VS), fs = sh(gl.FRAGMENT_SHADER, FS);
    if (vs && fs) {
      const prog = gl.createProgram()!;
      gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
      if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
        gl.useProgram(prog);
        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        ['R', 'T', 'S', 'M', 'LF', 'LI', 'HERO'].forEach((k) => { uni[k] = gl.getUniformLocation(prog, k); });
        glOK = true;
      } else console.error(gl.getProgramInfoLog(prog));
    }
  }
  if (!glOK) {
    cv.style.display = 'none';
    document.body.style.background = 'radial-gradient(120% 90% at 50% 6%,#5a2a26 0%,#1a0305 42%,#000000 100%)';
    document.body.style.backgroundAttachment = 'fixed';
    return;
  }

  function sizeGL() {
    const dpr = Math.min(window.devicePixelRatio || 1, window.innerWidth < 820 ? 1.0 : 1.35) * quality;
    cv!.width = Math.max(1, Math.floor(window.innerWidth * dpr));
    cv!.height = Math.max(1, Math.floor(window.innerHeight * dpr));
    gl!.viewport(0, 0, cv!.width, cv!.height);
  }
  sizeGL();

  /* bubbles */
  const bx = bc ? bc.getContext('2d') : null;
  let bubs: any[] = [];
  function sizeB() { if (bc) { bc.width = window.innerWidth; bc.height = window.innerHeight; } }
  function seedB() {
    bubs = [];
    const n = window.innerWidth < 820 ? 14 : (HERO ? 32 : 18);
    for (let i = 0; i < n; i++) bubs.push({
      x: Math.random() * window.innerWidth, y: Math.random() * window.innerHeight,
      r: 0.7 + Math.random() * 3.0, v: 0.2 + Math.random() * 0.75,
      w: Math.random() * 6.28, a: 0.05 + Math.random() * 0.24,
    });
  }
  sizeB(); seedB();
  function drawB() {
    if (!bx || !bc) return;
    bx.clearRect(0, 0, bc.width, bc.height);
    for (const b of bubs) {
      b.y -= b.v; b.w += 0.016;
      if (b.y < -12) { b.y = bc.height + 12; b.x = Math.random() * bc.width; }
      const x = b.x + Math.sin(b.w) * 8;
      bx.beginPath(); bx.arc(x, b.y, b.r, 0, 6.2832);
      bx.fillStyle = 'rgba(255,232,228,' + b.a + ')'; bx.fill();
      if (b.r > 2) {
        bx.beginPath(); bx.arc(x - b.r * 0.3, b.y - b.r * 0.3, b.r * 0.32, 0, 6.2832);
        bx.fillStyle = 'rgba(255,255,255,' + b.a * 1.5 + ')'; bx.fill();
      }
    }
  }

  const St = { s: 0, ts: 0, mx: 0, my: 0, tmx: 0, tmy: 0, lf: 0, tlf: 0, li: 0, tli: 0 };
  const scrollP = () => {
    const h = document.documentElement.scrollHeight - window.innerHeight;
    return h > 0 ? Math.min(1, Math.max(0, window.scrollY / h)) : 0;
  };
  addEventListener('scroll', () => { St.ts = scrollP(); }, { passive: true });
  St.ts = scrollP();
  addEventListener('pointermove', (e) => {
    St.tmx = (e.clientX / window.innerWidth) * 2 - 1;
    St.tmy = -((e.clientY / window.innerHeight) * 2 - 1);
  }, { passive: true });

  /* lane cards on the home page focus a lane in the water */
  document.querySelectorAll<HTMLElement>('[data-lane]').forEach((el) => {
    const f = parseFloat(el.dataset.lane || '0');
    const on = () => { St.tlf = f; St.tli = 1; };
    const off = () => { St.tli = 0; };
    el.addEventListener('pointerenter', on); el.addEventListener('focus', on);
    el.addEventListener('pointerleave', off); el.addEventListener('blur', off);
  });

  const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
  const t0 = performance.now();
  let frames = 0, degraded = false, running = true, winStart = 0, winFrames = 0;

  function frame(now: number) {
    requestAnimationFrame(frame);
    if (!running) return;
    const t = (now - t0) / 1000;
    St.s = lerp(St.s, St.ts, 0.095);
    St.mx = lerp(St.mx, St.tmx, 0.055);
    St.my = lerp(St.my, St.tmy, 0.055);
    St.lf = lerp(St.lf, St.tlf, 0.10);
    St.li = lerp(St.li, St.tli, 0.08);

    gl!.uniform2f(uni.R, cv!.width, cv!.height);
    gl!.uniform1f(uni.T, RM ? 12.0 : t);
    gl!.uniform1f(uni.S, St.s);
    gl!.uniform2f(uni.M, St.mx, St.my);
    gl!.uniform1f(uni.LF, St.lf);
    gl!.uniform1f(uni.LI, St.li);
    gl!.uniform1f(uni.HERO, HERO ? 1 : 0);
    gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    if (!RM) drawB();

    veil!.style.opacity = HERO ? (0.05 + St.s * 0.30).toFixed(3) : '0.46';

    const d = document.getElementById('depth');
    if (d) {
      const ft = (St.s * 16).toFixed(1);
      d.textContent = (ft.length < 4 ? '0' : '') + ft + ' FT';
    }

    frames++;
    if (!degraded) {
      if (frames === 30) { winStart = now; winFrames = 0; }
      else if (frames > 30) {
        winFrames++;
        if (winFrames === 90) {
          if ((now - winStart) / winFrames > 23) { quality = 0.66; sizeGL(); }
          degraded = true;
        }
      }
    }
  }
  requestAnimationFrame(frame);

  document.addEventListener('visibilitychange', () => { running = !document.hidden; });
  let rt: number;
  addEventListener('resize', () => {
    clearTimeout(rt);
    rt = window.setTimeout(() => { sizeGL(); sizeB(); seedB(); }, 140);
  });
})();
</script>
